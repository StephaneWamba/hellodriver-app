# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEBUG=false
# Comma-separated list of allowed origins (CORS + Socket.io)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL with PostGIS, e.g. Supabase pooler)
DATABASE_URL=postgresql://user:password@localhost:5432/hellodriver

# Redis (plain TCP, required by BullMQ; not Upstash HTTP)
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Optional, falls back to SUPABASE_JWT_SECRET
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_IN=7d

# SMS / OTP (SMS_PROVIDER=mock logs OTP codes to the console)
SMS_PROVIDER=mock
SMS_ORIGINATOR=HelloDriver
D7_NETWORKS_API_KEY=
OTP_TTL_SECONDS=600
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=3
# Dev-only: read OTP from Redis without SMS. Leave empty in production.
DEV_OTP_SECRET=

# pawaPay (Airtel Money / Moov Money). Leave PAWAPAY_BASE_URL unset to use
# the sandbox in development and the live API in production.
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_SECRET=
PAWAPAY_BASE_URL=
# UUID of the user that receives platform commissions
PLATFORM_USER_ID=

# Pricing and matching
TRIP_BASE_FARE_XAF=1500
TRIP_PER_KM_RATE_XAF=500
TRIP_ROAD_DISTANCE_FACTOR=1.3
DRIVER_MATCHING_RADIUS_KM=5
TRIP_BID_EXPIRY_MS=120000
TRIP_BID_REDIS_TTL_SECONDS=30
TRIP_ACTIVE_REDIS_TTL_SECONDS=7200
DRIVER_HEARTBEAT_TTL_SECONDS=25
DRIVER_ONLINE_TTL_SECONDS=86400

# Wallet limits (XAF) and payment polling
DEPOSIT_MIN_XAF=500
DEPOSIT_MAX_XAF=500000
PAYOUT_MIN_XAF=1000
PAYOUT_MAX_XAF=500000
PAYMENT_POLL_DELAY_MS=30000
PAYMENT_POLL_ATTEMPTS=5

# Google Maps (server-side only, used by the /places proxy)
GOOGLE_MAPS_API_KEY=

# WhatsApp agent (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
# Shared secret for the WhatsApp simulator channel
SIMULATOR_SECRET=

# LLM (provider:model, resolved through the Vercel AI SDK registry)
LLM_FAST_MODEL=anthropic:claude-haiku-4-5-20251001
LLM_QUALITY_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent tuning
AGENT_SESSION_TTL_SECONDS=14400
AGENT_LLM_FAST_TIMEOUT_MS=3000
AGENT_LLM_QUALITY_TIMEOUT_MS=8000
AGENT_CIRCUIT_BREAKER_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_RESET_MS=60000
AGENT_WHATSAPP_OUTBOUND_RATE=80
